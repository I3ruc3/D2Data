# Local builds can rewrite bundles under their upstream names. Revalidate on reuse.
/assets/*
  Cache-Control: no-cache
/data/*
  Cache-Control: no-cache
/items/*
  Cache-Control: public, max-age=2592000
/data_img/*
  Cache-Control: public, max-age=2592000
/app/*
  Cache-Control: public, max-age=2592000
/encyclopedia/*
  Cache-Control: public, max-age=86400
